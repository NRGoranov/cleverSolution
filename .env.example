# Resend API key — required for production contact form
RESEND_API_KEY=re_xxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=info@cleversolutions.bg

# Sender address (must be verified in Resend)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Public site URL for SEO (sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://cleversolutions.bg

# Set to 1 in Playwright e2e runs — skips Resend, returns success
CONTACT_TEST_MODE=0

# Set to 1 in Playwright e2e runs — exposes kitchenware placeholder as published
E2E_TEST=0
