# Gmail / Google Workspace mailbox that sends the contact emails
# (same as GoLa: App Password, not the normal Gmail login)
EMAIL_USER=office@cleversolution.bg
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact form submissions are delivered (comma-separated if several)
TO_EMAIL=office@cleversolution.bg

# Optional aliases — same meaning as EMAIL_USER / EMAIL_PASSWORD / TO_EMAIL
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=

# Optional: use Superhosting (or any SMTP) instead of Gmail
# SMTP_HOST=mail.superhosting.bg
# SMTP_PORT=465

# Public site URL for SEO (sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://cleversolutions.bg

# Set to 1 in Playwright e2e runs — skips SMTP, returns success
CONTACT_TEST_MODE=0

# Set to 1 in Playwright e2e runs — exposes kitchenware placeholder as published
E2E_TEST=0
